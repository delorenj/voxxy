# Voxxy self-hosted settings. install.sh copies this to .env and fills in the two
# secrets with random values the first time it runs; it never overwrites an existing .env.
# Keep .env private: it holds your API key.

# Filled in by install.sh.
POSTGRES_PASSWORD=
VOX_API_KEY=

# Where the service listens. 127.0.0.1 keeps it on this machine; 0.0.0.0 opens it to your network.
VOXXY_BIND=127.0.0.1
VOXXY_PORT=8000

# The address other programs use to fetch audio Voxxy makes. Change it if you open Voxxy to
# your network or put it behind your own proxy.
VOX_PUBLIC_BASE_URL=http://127.0.0.1:8000

# The voice used when a request names none.
VOX_DEFAULT_VOICE=house-f1

# Optional: an ElevenLabs fallback with your own ElevenLabs key.
ELEVENLABS_API_KEY=

# Optional: torch.compile in the engine (faster, more graphics memory).
VOX_OPTIMIZE=0
