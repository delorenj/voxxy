# 1password reference file. Safe to commit. `op run --env-file .env.template`
# resolves these at invocation time and exports to the child process only.
#
# Path convention: op://<vault>/<item>/<field>. Adjust if your vault names
# differ; everything here should live in DeLoSecrets.

DEFAULT_USERNAME=op://DeLoSecrets/PostgresLocal/username
DEFAULT_PASSWORD=op://DeLoSecrets/PostgresLocal/password

ELEVENLABS_API_KEY=op://DeLoSecrets/ElevenLabs/credential
ELEVENLABS_DEFAULT_VOICE=pNInz6obpgDQGcFmaJgB

# Voxxy API key (required since 2026-11-23). Every caller sends it as X-API-Key or
# Bearer; /healthz, /, /ui/*, /app-config, /audio/*.ogg and sink listening stay public.
VOX_API_KEY=op://DeLoSecrets/mpxfavdfzeqh7ahqc2r3qa6aki/credential

# Operator key for the consent review queue (GET/POST /consent/reviews, `voxxy consent ...`).
# Distinct from VOX_API_KEY: it opens only those routes. Create the item before enabling.
# Parked for Jarad (credential creation): uncomment once the item exists. Until then the
# review routes answer 503 "no operator key configured"; the consent gate itself works.
# VOX_OPERATOR_KEY=op://DeLoSecrets/voxxy-operator-key/credential
